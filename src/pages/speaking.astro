---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

const FORM_ENDPOINT = 'https://formspree.io/f/xkoerznn';

// Recent stages — photo gallery. Files live at /public/img/speaking/.
// If a file is missing we render an inline SVG placeholder so the page never
// shows a broken image — drop your real JPG at the exact path and it'll
// replace the placeholder on next build.
const photoDir = path.join(process.cwd(), 'public', 'img', 'speaking');
const stages = [
  {
    file: '01-campaign-year-ahead.jpg',
    eyebrow: 'Campaign · Year Ahead',
    body: 'Toronto. Industry gathering on the year ahead in brand, media, and creative.',
    alt: 'Noah Barlow at Campaign Year Ahead, Toronto',
  },
  {
    file: '02-arcteryx-workshop.jpg',
    eyebrow: 'Brand workshop · Arc’teryx',
    body: 'Private working session on brand promise, category positioning, and how a premium brand earns its right to a price.',
    alt: 'Noah Barlow leading an Arc’teryx brand workshop',
  },
  {
    file: '03-founder-workshop.jpg',
    eyebrow: 'Founder offsite · Workshop',
    body: 'Working session on bringing brand promise to life through packaging, retail, and demand sequencing.',
    alt: 'Noah Barlow presenting brand strategy at a founder offsite',
  },
  {
    file: '04-tech-halls.jpg',
    eyebrow: 'Tech in the Halls · Westage',
    body: 'Industry talk on commerce-led brand strategy for tech and SaaS audiences. Toronto.',
    alt: 'Noah Barlow speaking at Tech in the Halls, Westage',
  },
].map((s, i) => ({
  ...s,
  index: String(i + 1).padStart(2, '0'),
  exists: fs.existsSync(path.join(photoDir, s.file)),
}));

// Highlight clip — short video reel. Drop a web-ready MP4 at the exact path
// to replace the placeholder. (Original .mov copied to that path too as a
// fallback for browsers that handle QuickTime.)
const clipMp4Path = path.join(photoDir, 'noah-speaking-clip.mp4');
const clipMovPath = path.join(photoDir, 'noah-speaking-clip.mov');
const hasClip = fs.existsSync(clipMp4Path) || fs.existsSync(clipMovPath);
const clipMp4Exists = fs.existsSync(clipMp4Path);
const clipMovExists = fs.existsSync(clipMovPath);

// Four talks. Each is a real argument, not a topic. Titles echo existing site
// content (essays + diagnostics) so the speaking work compounds with the rest
// of the brand instead of standing apart.
const talks = [
  {
    n: 'T01',
    cat: 'Packaging · Retail · CPG',
    title: 'Packaging is media. <em>(You\'ve already paid for it.)</em>',
    abstract:
      'Most CPG founders pour budget into paid demand to fix what is actually a packaging problem. A working talk on why the package is the most under-leveraged growth lever a brand owns — and how to read whether yours is pulling its weight at shelf in three seconds.',
    fit: 'CPG conferences, retail innovation summits, founder offsites, in-house brand teams.',
    formats: ['Keynote · 30–45 min', 'Workshop · 90 min', 'Private brand-team session'],
    related: { href: '/thinking/packaging-is-media', label: 'Read the essay →' },
  },
  {
    n: 'T02',
    cat: 'Challenger brands · Strategy',
    title: 'Consensus <em>kills</em> demand.',
    abstract:
      'The brands that move a category are not the ones everyone in the room agreed with. They are the ones half the room would have rejected. A talk on why sharpness, not safety, is the only durable growth strategy — and how a founder-led brand gets back to a decision the cautious version of itself cannot survive.',
    fit: 'Founder summits, brand strategy conferences, marketing leadership events, growth conferences.',
    formats: ['Keynote · 30–45 min', 'Fireside · 30–45 min'],
    related: { href: '/thinking/consensus-kills-demand', label: 'Read the essay →' },
  },
  {
    n: 'T03',
    cat: 'Retail · Commerce',
    title: 'How brands <em>earn the shelf.</em>',
    abstract:
      'The seam between brand and retail is where most launches die. A talk on the three jobs a package has to do at shelf in three seconds, what most founders mis-budget against, and what to do when you are up against the category leader\'s planogram with a quarter of the spend.',
    fit: 'CPG conferences, beverage and RTD summits, retail innovation events, working sessions for brand teams ahead of a launch.',
    formats: ['Keynote · 30–45 min', 'Working session · 90 min', 'Panel'],
    related: { href: '/diagnostics', label: 'See the Packaging Audit →' },
  },
  {
    n: 'T04',
    cat: 'Design culture · Gen-Z',
    title: 'The Modern Brand <em>OS.</em>',
    abstract:
      'Gen-Z is rewriting the rules of attention, meaning, and loyalty in every category at once. A talk on eleven operating principles for brands trying to behave bigger than they spend in a world where the old playbook is now expensive to run.',
    fit: 'Design conferences, brand strategy events, founder education, agency leadership offsites.',
    formats: ['Keynote · 45–60 min', 'Workshop · 90–120 min'],
    related: { href: '/modern-brand-os', label: 'Take the Modern Brand OS →' },
  },
];

// Formats reference. Used by the booking form dropdown + the formats section.
const formats = [
  {
    name: 'Keynote',
    duration: '30–45 min',
    body: 'Stage time. One sharp argument, real-world examples from twenty years of operating, three takeaways the audience can use Monday.',
  },
  {
    name: 'Fireside / interview',
    duration: '30–45 min',
    body: 'On stage with a host. Best for rooms where the audience already knows the topic and wants the operator perspective, not the 101.',
  },
  {
    name: 'Workshop',
    duration: '60–120 min',
    body: 'Small-group working session. Includes a custom diagnostic tied to the talk topic — your audience leaves with a scored read on their own brand, not just inspiration.',
  },
  {
    name: 'Panel',
    duration: '15–25 min',
    body: 'For industry summits where you want a sharp counter-position on stage with peers. Best when the panel is three voices or fewer.',
  },
  {
    name: 'Private brand-team session',
    duration: '90 min – half day',
    body: 'In-house at the company. Best when you want the team to leave with a specific decision made, not just an idea floated. Often booked alongside an advisory engagement.',
  },
];
---

<BaseLayout
  title="Speaking · Noah Barlow"
  description="Direct talks on packaging, retail, challenger brands, and design culture. Twenty years of operator perspective for CPG founders, brand teams, and the rooms that want a real read."
>
  <!-- HERO -->
  <section class="hero">
    <div class="shell">
      <p class="eyebrow">Speaking</p>
      <h1 style="margin-top: 1.5rem; max-width: 18ch;">
        Talks for rooms that want <em>a real read.</em>
      </h1>
      <p class="hero-sub">
        Twenty years of operating. Brand, packaging, retail, and challenger
        thinking — direct, opinionated, working. No deck disease, no
        motivational arc, no "five trends to watch." One sharp argument and
        the examples that earned it.
      </p>
      <div class="hero-meta">
        <div class="item"><strong>4</strong><span>signature talks</span></div>
        <div class="item"><strong>5</strong><span>formats</span></div>
        <div class="item"><strong>20+</strong><span>years operating</span></div>
        <div class="item"><strong>48h</strong><span>reply window</span></div>
      </div>
    </div>
  </section>

  <!-- WHO IT'S FOR -->
  <section>
    <div class="shell">
      <div class="runhead"><span class="n">01</span><span class="l">Where I'm useful</span></div>
      <div class="s-head">
        <div class="left">
          <h2>The rooms I'm built for. <em>And the ones I'm not.</em></h2>
        </div>
        <div class="right">
          <p>
            I work best in rooms that want the operator version, not the
            keynote version. Founder summits, CPG conferences, retail
            innovation events, packaging and design culture rooms, marketing
            leadership offsites, and private brand teams who need an outside
            read before a big decision.
          </p>
          <p style="margin-top: 1.2em;">
            I skip the generic "leadership" circuit, motivational arcs, and
            five-person panels — you cannot say anything sharp in five
            minutes, and I am not interested in pretending otherwise.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- TALKS -->
  <section>
    <div class="shell">
      <div class="runhead"><span class="n">02</span><span class="l">The talks</span></div>
      <div class="s-head">
        <div class="left">
          <h2>Four arguments. <em>Pick the one that fits the room.</em></h2>
        </div>
        <div class="right">
          <p>
            Each of these is a working talk built around a real argument I
            have made in front of brand teams, founders, and investors. I am
            happy to remix a hybrid for a specific audience — but I will not
            change the underlying claim to fit the booker's comfort zone.
          </p>
        </div>
      </div>

      <ul class="talks" style="list-style:none; padding:0; margin: clamp(2rem,4vw,3.5rem) 0 0;">
        {talks.map((t) => (
          <li class="talk">
            <div class="talk-meta">
              <span class="n">{t.n}</span>
              <span class="cat">{t.cat}</span>
            </div>
            <h3 class="talk-title" set:html={t.title}></h3>
            <p class="talk-abstract">{t.abstract}</p>
            <div class="talk-grid">
              <div>
                <p class="eyebrow" style="display:block; margin-bottom:0.4em;">Best fit</p>
                <p style="color: var(--ink-2); max-width: 38ch;">{t.fit}</p>
              </div>
              <div>
                <p class="eyebrow" style="display:block; margin-bottom:0.4em;">Formats</p>
                <ul style="list-style:none; padding:0; margin:0;">
                  {t.formats.map((f) => (
                    <li style="margin-bottom: 0.3em; color: var(--ink-2);">{f}</li>
                  ))}
                </ul>
              </div>
            </div>
            {t.related && (
              <p style="margin-top: 1.25rem;">
                <a href={t.related.href} style="font-size: var(--t-sm);">{t.related.label}</a>
              </p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- DARK CALLOUT -->
  <section class="dark">
    <div class="shell">
      <div class="callout">
        <span class="mark">&ldquo;</span>
        <p class="q">
          The version of the talk that everyone in the prep call agreed with
          is the one that <em>nobody remembers</em>. Same rule as brand.
        </p>
        <p class="attr">&mdash; Noah Barlow</p>
      </div>
    </div>
  </section>

  <!-- FORMATS -->
  <section>
    <div class="shell">
      <div class="runhead"><span class="n">03</span><span class="l">Formats</span></div>
      <div class="s-head">
        <div class="left">
          <h2>Pick the shape <em>that fits the goal.</em></h2>
        </div>
        <div class="right">
          <p>
            A keynote is not always the right move. A workshop usually
            outperforms a keynote for a working team. A fireside lands harder
            than a keynote when the audience already knows the territory.
            Open to all five; happy to recommend the right one once I see the
            audience and the goal.
          </p>
        </div>
      </div>

      <div class="formats" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: clamp(1.25rem, 2.5vw, 2rem); margin-top: clamp(2rem,4vw,3.5rem);">
        {formats.map((f, i) => (
          <div class="format-card">
            <div class="runhead">
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <span class="l">{f.duration}</span>
            </div>
            <h3 style="margin-top: 0.85rem; font-size: var(--t-xl);">{f.name}</h3>
            <p style="margin-top: 0.85rem; color: var(--ink-2);">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- RECENT STAGES — photo gallery -->
  <section>
    <div class="shell">
      <div class="runhead"><span class="n">04</span><span class="l">Recent stages</span></div>
      <div class="s-head">
        <div class="left">
          <h2>Where the work has <em>landed.</em></h2>
        </div>
        <div class="right">
          <p>
            Industry stages, private brand workshops, founder offsites. The
            talks travel &mdash; the underlying argument doesn't bend to fit
            the room.
          </p>
        </div>
      </div>

      <div class="stages-grid">
        {stages.map((s) => (
          <figure class="stage">
            <div class="stage-frame">
              {s.exists ? (
                <img src={`/img/speaking/${s.file}`} alt={s.alt} loading="lazy" />
              ) : (
                <div class="stage-placeholder" aria-hidden="true">
                  <span class="ph-n">{s.index}</span>
                  <span class="ph-l">{s.eyebrow}</span>
                  <span class="ph-drop">Drop photo at <code>public/img/speaking/{s.file}</code></span>
                </div>
              )}
            </div>
            <figcaption>
              <p class="eyebrow" style="display:block;">{s.eyebrow}</p>
              <p class="stage-body">{s.body}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {hasClip && (
    <!-- HIGHLIGHT CLIP — short video reel -->
    <section style="padding-top: 0;">
      <div class="shell">
        <div class="clip-wrap">
          <video
            class="clip"
            playsinline
            muted
            loop
            autoplay
            preload="metadata"
            aria-label="Noah Barlow speaking — short reel"
          >
            {clipMp4Exists && <source src="/img/speaking/noah-speaking-clip.mp4" type="video/mp4" />}
            {clipMovExists && <source src="/img/speaking/noah-speaking-clip.mov" type="video/quicktime" />}
          </video>
          <p class="clip-caption">
            <span class="eyebrow" style="display:block; margin-bottom: 0.4em;">Short reel</span>
            A minute of the actual delivery &mdash; pace, posture, the way an
            argument lands in a real room.
          </p>
        </div>
      </div>
    </section>
  )}

  <!-- BOOKING -->
  <section>
    <div class="shell">
      <div class="runhead"><span class="n">05</span><span class="l">Book it</span></div>
      <div class="contact-grid">
        <!-- Left: form -->
        <div>
          <p class="eyebrow" style="display:block; margin-bottom: 0.85em;">Bring me the room</p>
          <h2 style="font-size: var(--t-2xl); max-width: 22ch; margin-bottom: 1.25rem;">
            Tell me the audience. <em>I'll tell you the talk.</em>
          </h2>
          <p style="color: var(--ink-2); max-width: 56ch; margin-bottom: 2rem;">
            Send the basics. I will personally reply within 48 hours with a
            read on whether there is a fit, a recommended format, and a
            confirmation on whether dates work. No agent layer, no "speaker
            bureau" rep.
          </p>

          <form action={FORM_ENDPOINT} method="POST" id="speaking-form" class="contact-form">
            <input type="hidden" name="_subject" value="Speaking inquiry — new lead" />
            <input type="hidden" name="source" value="speaking" />

            <p class="field-group-label">Basics</p>

            <div class="field">
              <label for="sf-name">Name</label>
              <input type="text" id="sf-name" name="name" autocomplete="name" required />
            </div>

            <div class="field">
              <label for="sf-email">Email</label>
              <input type="email" id="sf-email" name="email" autocomplete="email" placeholder="you@organization.com" required />
            </div>

            <div class="field">
              <label for="sf-org">Organization or event name</label>
              <input type="text" id="sf-org" name="organization" placeholder="The host, conference, or company" required />
            </div>

            <p class="field-group-label">The event</p>

            <div class="field">
              <label for="sf-audience">Audience &mdash; who's in the room</label>
              <textarea id="sf-audience" name="audience" rows="3" placeholder="Size, composition, seniority. Two or three sentences is plenty." required></textarea>
            </div>

            <div class="field">
              <label for="sf-when">When</label>
              <input type="text" id="sf-when" name="when" placeholder="Date(s), window, or 'TBD'" required />
            </div>

            <div class="field">
              <fieldset>
                <legend style="font-family: var(--font-sans); font-size: var(--t-sm); font-weight: 600; color: var(--ink); letter-spacing: 0.02em; margin-bottom: 0.4em;">
                  Format you're considering
                </legend>
                <div class="field-checks">
                  <label><input type="checkbox" name="format[]" value="Keynote" /> Keynote</label>
                  <label><input type="checkbox" name="format[]" value="Fireside / interview" /> Fireside / interview</label>
                  <label><input type="checkbox" name="format[]" value="Workshop" /> Workshop</label>
                  <label><input type="checkbox" name="format[]" value="Panel" /> Panel</label>
                  <label><input type="checkbox" name="format[]" value="Private brand-team session" /> Private brand-team session</label>
                  <label><input type="checkbox" name="format[]" value="Not sure yet" /> Not sure yet</label>
                </div>
              </fieldset>
            </div>

            <div class="field">
              <fieldset>
                <legend style="font-family: var(--font-sans); font-size: var(--t-sm); font-weight: 600; color: var(--ink); letter-spacing: 0.02em; margin-bottom: 0.4em;">
                  Topic interest
                </legend>
                <div class="field-checks">
                  <label><input type="checkbox" name="topic[]" value="Packaging is media (T01)" /> Packaging is media (T01)</label>
                  <label><input type="checkbox" name="topic[]" value="Consensus kills demand (T02)" /> Consensus kills demand (T02)</label>
                  <label><input type="checkbox" name="topic[]" value="How brands earn the shelf (T03)" /> How brands earn the shelf (T03)</label>
                  <label><input type="checkbox" name="topic[]" value="The Modern Brand OS (T04)" /> The Modern Brand OS (T04)</label>
                  <label><input type="checkbox" name="topic[]" value="Custom / hybrid" /> Custom / hybrid &mdash; tell me below</label>
                </div>
              </fieldset>
            </div>

            <p class="field-group-label">Optional</p>

            <div class="field">
              <label for="sf-budget">Budget shape</label>
              <select id="sf-budget" name="budget">
                <option value="">Select if you have a sense</option>
                <option value="Under $5k">Under $5k &middot; small / educational</option>
                <option value="$5k–$15k">$5k&ndash;$15k &middot; mid-size event</option>
                <option value="$15k–$30k">$15k&ndash;$30k &middot; standard keynote</option>
                <option value="$30k+">$30k+ &middot; large stage or private workshop</option>
                <option value="Honorarium / pro-bono">Honorarium / pro-bono</option>
                <option value="Not sure yet">Not sure yet</option>
              </select>
            </div>

            <div class="field">
              <label for="sf-notes">Anything else</label>
              <textarea id="sf-notes" name="notes" rows="3" placeholder="A specific angle, a co-speaker, travel logistics, the thing you wish more speakers understood about your audience."></textarea>
            </div>

            <div class="field-actions" style="margin-top: 1.5rem;">
              <button type="submit" class="btn hot" id="sf-submit">Send inquiry &rarr;</button>
              <span class="legal">One human reply within 48h. No agent layer, no speaker bureau.</span>
            </div>
          </form>

          <div class="contact-thanks" id="speaking-thanks">
            <h3>Thanks &mdash; that's in.</h3>
            <p>
              I'll personally reply within 48 hours with a read on whether
              there's a fit, a format recommendation, and a confirmation on
              dates.
            </p>
          </div>
        </div>

        <!-- Right: email-instead callout -->
        <div>
          <div class="contact-email-callout">
            <p class="eyebrow" style="display:block;">Or just email me</p>
            <p class="big">Skip the form.</p>
            <p style="margin: 0;">
              <a href="mailto:noah@smalleragency.com?subject=Speaking%20inquiry" class="addr">noah@smalleragency.com</a>
            </p>
            <p>
              Subject line "Speaking inquiry" and the basics &mdash; audience,
              date, format you're considering. Three sentences beats thirty
              fields.
            </p>
          </div>

          <p class="eyebrow" style="display:block; margin-bottom: 0.85em;">Also</p>
          <p style="font-size: var(--t-sm); margin-bottom: 0.4em;">
            <a href="https://www.linkedin.com/in/noahbarlow/" target="_blank" rel="noopener">LinkedIn &rarr;</a>
          </p>
          <p style="font-size: var(--t-sm); margin-bottom: 0.4em;">
            <a href="/thinking">Read the essays &rarr;</a>
          </p>
          <p style="font-size: var(--t-sm); margin-bottom: 0.4em;">
            <a href="/diagnostics">Take a diagnostic &rarr;</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- TORONTO / TRAVEL -->
  <section style="text-align: center; padding-bottom: clamp(3rem, 6vw, 6rem);">
    <div class="shell shell-narrow">
      <p class="eyebrow">Based in Toronto</p>
      <h2 style="margin-top: 1rem;">Open to travel. <em>Selective on calendar.</em></h2>
      <p style="margin-top: 1.25rem; color: var(--mute); max-width: 48ch; margin-left: auto; margin-right: auto;">
        Roughly 6&ndash;10 speaking dates per year. Strong preference for
        events where I can also have one or two real working sessions with
        founders or brand teams in the same trip.
      </p>
    </div>
  </section>

  <script is:inline>
    (function () {
      const form = document.getElementById('speaking-form');
      const thanks = document.getElementById('speaking-thanks');
      const submitBtn = document.getElementById('sf-submit');
      if (!form) return;

      const showError = (msg) => {
        let err = document.getElementById('sf-err');
        if (!err) {
          err = document.createElement('p');
          err.id = 'sf-err';
          err.className = 'legal';
          err.style.color = '#a31d10';
          err.style.marginTop = '0.6rem';
          form.appendChild(err);
        }
        err.innerHTML = msg || "That didn't send. Email <a href=\"mailto:noah@smalleragency.com\">noah@smalleragency.com</a> directly and I'll respond personally.";
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }
        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          if (res.ok) {
            if (typeof window.trackLead === 'function') {
              const budget = form.querySelector('[name="budget"]')?.value || '';
              window.trackLead('speaking', { budget });
            }
            form.style.display = 'none';
            thanks.style.display = 'block';
            window.scrollTo({ top: form.getBoundingClientRect().top + window.scrollY - 80, behavior: 'instant' });
          } else {
            showError();
            if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Send inquiry →'; }
          }
        } catch (err) {
          showError();
          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Send inquiry →'; }
        }
      });
    })();
  </script>

  <style is:inline>
    /* Talk cards — editorial list rather than tiles. Each talk is its own argument. */
    .talk {
      border-top: var(--rule-w) solid var(--rule);
      padding: clamp(2rem, 3.5vw, 3rem) 0;
    }
    .talk:last-child { border-bottom: var(--rule-w) solid var(--rule); }
    .talk-meta {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      margin-bottom: 1rem;
    }
    .talk-meta .n {
      font-family: var(--font-display);
      font-size: var(--t-lg);
      color: var(--mute);
    }
    .talk-meta .cat {
      font-size: var(--t-xs);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--mute);
    }
    .talk-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 1.6rem + 2vw, 3.25rem);
      line-height: 1.04;
      letter-spacing: -0.018em;
      margin: 0 0 1.25rem;
      max-width: 22ch;
    }
    .talk-abstract {
      font-size: var(--t-md);
      color: var(--ink-2);
      max-width: 64ch;
      margin: 0 0 1.5rem;
    }
    .talk-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(1.5rem, 3vw, 2.5rem);
      margin-top: 1.5rem;
    }
    @media (max-width: 640px) {
      .talk-grid { grid-template-columns: 1fr; gap: 1.25rem; }
    }
    .format-card {
      border-top: var(--rule-w) solid var(--rule);
      padding-top: 1.25rem;
    }

    /* Stages — editorial photo gallery. Grayscale-by-default with a hover
       reveal to color; thin paper frame; eyebrow + body caption beneath. */
    .stages-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: clamp(1.75rem, 3.5vw, 3rem);
      margin-top: clamp(2rem, 4vw, 3.5rem);
    }
    @media (max-width: 720px) {
      .stages-grid { grid-template-columns: 1fr; gap: 2rem; }
    }
    .stage { margin: 0; display: flex; flex-direction: column; }
    .stage-frame {
      position: relative;
      aspect-ratio: 4 / 3;
      background: var(--paper-2);
      overflow: hidden;
      border: 1px solid rgba(10,10,10,0.08);
    }
    .stage-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      filter: grayscale(82%) contrast(1.06);
      transition: filter 450ms var(--easing), transform 650ms var(--easing);
    }
    .stage:hover .stage-frame img {
      filter: grayscale(0%) contrast(1);
      transform: scale(1.02);
    }
    .stage figcaption {
      margin-top: 1.1rem;
    }
    .stage-body {
      color: var(--ink-2);
      font-size: var(--t-sm);
      margin: 0;
      max-width: 44ch;
      line-height: 1.55;
    }

    /* Placeholder slot (rendered when no real photo file exists at the path). */
    .stage-placeholder {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: space-between;
      padding: 1.5rem;
      background: var(--paper-2);
      color: var(--mute);
    }
    .stage-placeholder::before {
      content: "";
      position: absolute;
      left: 1.5rem;
      top: 1.5rem;
      width: 1.75rem;
      height: 1.75rem;
      background: var(--accent);
    }
    .stage-placeholder .ph-n {
      font-family: var(--font-display);
      font-size: var(--t-3xl);
      line-height: 1;
      color: var(--ink);
      margin-top: 3.25rem;
    }
    .stage-placeholder .ph-l {
      font-size: var(--t-xs);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--mute);
      margin-top: 0.5rem;
    }
    .stage-placeholder .ph-drop {
      font-size: var(--t-xs);
      color: var(--mute);
      font-family: var(--font-sans);
      margin-top: auto;
      line-height: 1.5;
      word-break: break-word;
    }
    .stage-placeholder code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.92em;
      color: var(--ink-2);
      background: rgba(10,10,10,0.05);
      padding: 0.1em 0.4em;
      border-radius: 2px;
    }

    /* Highlight clip — short video reel. Sits below the gallery, full-bleed
       within the shell, with a quiet caption underneath. */
    .clip-wrap {
      margin-top: clamp(2.5rem, 4vw, 3.5rem);
    }
    .clip {
      width: 100%;
      max-height: 70vh;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      display: block;
      background: var(--ink);
      border: 1px solid rgba(10,10,10,0.08);
