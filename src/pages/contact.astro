---
import BaseLayout from '../layouts/BaseLayout.astro';

const FORM_ENDPOINT = 'https://formspree.io/f/xkoerznn';
---

<BaseLayout
  title="Contact · Noah Barlow"
  description="Send a brief. Senior brand, packaging, and growth leadership for founder-led companies."
>
  <script is:inline>document.body.setAttribute('data-page', 'contact');</script>

  <section class="hero">
    <div class="shell">
      <p class="eyebrow">Contact</p>
      <h1 style="margin-top: 1.5rem; max-width: 16ch;">
        Bring the brief.<br /><em>I'll bring the framing.</em>
      </h1>
      <p class="hero-sub">
        Selective engagements only. Send the brief below &mdash; or just
        email me directly. Either way, I'll personally reply within 48 hours
        with a read on whether there's a fit.
      </p>
    </div>
  </section>

  <!-- FORM -->
  <section style="padding-top: 0;">
    <div class="shell">
      <div class="contact-grid">
        <!-- Left: Brief form -->
        <div>
          <p class="eyebrow" style="display:block; margin-bottom: 0.85em;">The brief</p>
          <h2 style="font-size: var(--t-2xl); max-width: 22ch; margin-bottom: 1.25rem;">
            A few honest answers. <em>Then a real reply.</em>
          </h2>
          <p style="color: var(--ink-2); max-width: 56ch; margin-bottom: 2rem;">
            Answer what you have answers to. Leave the rest blank. The honest
            version of each answer is more useful to me than the polished
            version. Takes most founders 10&ndash;15 minutes.
          </p>

          <form action={FORM_ENDPOINT} method="POST" id="contact-form" class="contact-form">
            <input type="hidden" name="_subject" value="Brief — new lead" />
            <input type="hidden" name="source" value="brief" />

            <p class="field-group-label">Basics</p>

            <div class="field">
              <label for="cf-name">Name</label>
              <input type="text" id="cf-name" name="name" autocomplete="name" required />
            </div>

            <div class="field">
              <label for="cf-email">Email</label>
              <input type="email" id="cf-email" name="email" autocomplete="email" placeholder="you@company.com" required />
            </div>

            <div class="field">
              <label for="cf-company">Brand or company</label>
              <input type="text" id="cf-company" name="company" autocomplete="organization" placeholder="What you're building" required />
            </div>

            <p class="field-group-label">The work</p>

            <div class="field">
              <label for="cf-where">Where you are now</label>
              <textarea id="cf-where" name="where" rows="4" placeholder="2–3 sentences. Stage, momentum, what's working, what isn't." required></textarea>
            </div>

            <div class="field">
              <label for="cf-move">What you're trying to move</label>
              <textarea id="cf-move" name="move" rows="3" placeholder="In 6–12 months, what changes if this works?" required></textarea>
            </div>

            <div class="field">
              <fieldset>
                <legend style="font-family: var(--font-sans); font-size: var(--t-sm); font-weight: 600; color: var(--ink); letter-spacing: 0.02em; margin-bottom: 0.4em;">
                  What kind of help do you think this is?
                </legend>
                <div class="field-checks">
                  <label><input type="checkbox" name="help[]" value="Brand strategy" /> Brand strategy</label>
                  <label><input type="checkbox" name="help[]" value="Packaging system" /> Packaging system</label>
                  <label><input type="checkbox" name="help[]" value="Growth leadership" /> Growth leadership</label>
                  <label><input type="checkbox" name="help[]" value="Not sure yet" /> Not sure yet</label>
                </div>
              </fieldset>
            </div>

            <div class="field">
              <label for="cf-budget">Budget shape</label>
              <select id="cf-budget" name="budget" required>
                <option value="">Select a range</option>
                <option value="Under $10k">Under $10k &middot; one-off / discovery</option>
                <option value="$10k–$25k">$10k&ndash;$25k &middot; project</option>
                <option value="$25k–$50k">$25k&ndash;$50k &middot; engagement</option>
                <option value="$50k+">$50k+ &middot; retainer or larger</option>
                <option value="Not sure yet">Not sure yet &middot; exploring</option>
              </select>
            </div>

            <p class="field-group-label">Optional &middot; the most useful answers I get</p>

            <div class="field">
              <label for="cf-tried">What you've already tried</label>
              <textarea id="cf-tried" name="tried" rows="3" placeholder="What did you try, and why didn't it land?"></textarea>
            </div>

            <div class="field">
              <label for="cf-take">The take you'd defend</label>
              <textarea id="cf-take" name="take" rows="3" placeholder="Is there something you believe about your category, audience, or brand that the room doesn't agree with?"></textarea>
              <p class="field-help">
                This is the question that tells me most about whether we'll
                work well together. Skip it if you'd rather get into it on a call.
              </p>
            </div>

            <div class="field-actions" style="margin-top: 1.5rem;">
              <button type="submit" class="btn hot" id="cf-submit">Send the brief &rarr;</button>
              <span class="legal">One human reply within 48h. No newsletter, no follow-up sequence.</span>
            </div>
          </form>

          <div class="contact-thanks" id="contact-thanks">
            <h3>Thanks &mdash; that's in.</h3>
            <p>
              I'll personally reply within 48 hours with a read on whether
              there's a fit. If we're a match, the next move is a thirty-minute
              call to discuss the actual problem.
            </p>
          </div>
        </div>

        <!-- Right: Just email me callout + alt paths -->
        <div>
          <div class="contact-email-callout">
            <p class="eyebrow" style="display:block;">Don't want to fill it out?</p>
            <p class="big">Just email me.</p>
            <p style="margin: 0;">
              <a href="mailto:noah@smalleragency.com?subject=Brief%20%E2%80%94%20direct" class="addr">noah@smalleragency.com</a>
            </p>
            <p>
              Three honest sentences beat thirty form fields. The shortest
              version of your actual problem is the one most useful to me.
            </p>
          </div>

          <p class="eyebrow" style="display:block; margin-bottom: 0.85em;">Also</p>
          <p style="font-size: var(--t-sm); margin-bottom: 0.4em;">
            <a href="https://www.linkedin.com/in/noahbarlow/" target="_blank" rel="noopener">LinkedIn &rarr;</a>
          </p>
          <p style="font-size: var(--t-sm); margin-bottom: 0.4em;">
            <a href="/diagnostics">Take a diagnostic instead &rarr;</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT HAPPENS NEXT -->
  <section>
    <div class="shell">
      <div class="s-head">
        <div class="left">
          <span class="eyebrow">What happens next</span>
          <h2>A simple process.</h2>
        </div>
        <div class="right">
          <p>
            No drawn-out discovery calls. No pitch decks. The first
            conversation is thirty minutes, focused on the actual problem,
            and ends with a clear next step &mdash; either a scoped engagement
            proposal or a referral to someone better-fit.
          </p>
        </div>
      </div>

      <div class="framework">
        <div class="step">
          <div class="num">01</div>
          <h3>Intro call</h3>
          <p>Thirty minutes. The problem, the constraints, what's already been tried. Honest read on whether there's a fit.</p>
        </div>
        <div class="step">
          <div class="num">02</div>
          <h3>Scope</h3>
          <p>A short written proposal. One page. Outcomes, sequencing, and time commitment &mdash; nothing decorative.</p>
        </div>
        <div class="step">
          <div class="num">03</div>
          <h3>Start</h3>
          <p>Diagnostic kicks off within ten business days. Working sessions, not status meetings. Decisions get made.</p>
        </div>
      </div>
    </div>
  </section>

  <section style="text-align: center;">
    <div class="shell shell-narrow">
      <p class="eyebrow">Based in Toronto</p>
      <h2 style="margin-top: 1rem;">Working with founders across North America.</h2>
      <p style="margin-top: 1.25rem; color: var(--mute);">
        Selectively available &middot; 2026
      </p>
    </div>
  </section>

  <script is:inline>
    (function () {
      const form = document.getElementById('contact-form');
      const thanks = document.getElementById('contact-thanks');
      const submitBtn = document.getElementById('cf-submit');
      if (!form) return;

      const showError = (msg) => {
        let err = document.getElementById('cf-err');
        if (!err) {
          err = document.createElement('p');
          err.id = 'cf-err';
          err.className = 'legal';
          err.style.color = '#a31d10';
          err.style.marginTop = '0.6rem';
          form.appendChild(err);
        }
        err.innerHTML = msg || "That didn't send. Email <a href=\"mailto:noah@smalleragency.com\">noah@smalleragency.com</a> directly and I'll respond personally.";
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }
        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          if (res.ok) {
            // Fire conversion to GA4 + Google Ads + LinkedIn + Meta
            if (typeof window.trackLead === 'function') {
              const budget = form.querySelector('[name="budget"]')?.value || '';
              window.trackLead('brief', { budget });
            }
            form.style.display = 'none';
            thanks.style.display = 'block';
            window.scrollTo({ top: form.getBoundingClientRect().top + window.scrollY - 80, behavior: 'instant' });
          } else {
            showError();
            if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Send the brief →'; }
          }
        } catch (err) {
          showError();
          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Send the brief →'; }
        }
      });
    })();
  </script>
</BaseLayout>
