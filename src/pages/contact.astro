---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact · Noah Barlow"
  description="Book a strategy call or send a brief. Selective engagements for founder-led brands. Brand, packaging, and growth leadership."
>
  <section class="hero">
    <div class="shell">
      <p class="eyebrow">Contact</p>
      <h1 style="margin-top: 1.5rem; max-width: 16ch;">
        Bring the brief.<br /><em>I'll bring the framing.</em>
      </h1>
      <p class="hero-sub">
        Selective engagements only. The fastest way to find out whether
        there's a fit is a thirty-minute call. If you prefer email, that
        works too.
      </p>
    </div>
  </section>

  <section style="padding-top: 0;">
    <div class="shell">
      <div class="advisory">
        <div>
          <p class="eyebrow">Direct</p>
          <h2 style="margin-top: 1rem; font-size: var(--t-2xl);">noah@smalleragency.com</h2>
          <p style="margin-top: 1.25rem; color: var(--ink-2); max-width: 38ch;">
            Send the brief in your own words. The shorter, the better — I'd
            rather read three sentences with a real problem than three
            pages of context.
          </p>
          <div style="margin-top: 1.75rem; display: flex; gap: 0.85rem; flex-wrap: wrap;">
            <a href="mailto:noah@smalleragency.com?subject=Strategy%20call%20%E2%80%94%20intro" class="btn hot">Email Noah</a>
            <a href="https://www.linkedin.com/in/noahbarlow/" target="_blank" rel="noopener" class="btn ghost">LinkedIn</a>
          </div>
        </div>

        <div>
          <p class="eyebrow">What helps</p>
          <ul class="bullets" style="margin-top: 1rem;">
            <li><span class="k">01</span><span class="v">Company name and one-line description</span></li>
            <li><span class="k">02</span><span class="v">Stage, channel mix, and rough scale</span></li>
            <li><span class="k">03</span><span class="v">The specific decision you're trying to make</span></li>
            <li><span class="k">04</span><span class="v">Timing — is this a now problem or a next-quarter problem</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="shell">
      <div class="s-head">
        <div class="left">
          <span class="eyebrow">What happens next</span>
          <h2>A simple process.</h2>
        </div>
        <div class="right">
          <p>
            No drawn-out discovery calls. No pitch decks. The first
            conversation is thirty minutes, focused on the actual problem,
            and ends with a clear next step — either a scoped engagement
            proposal or a referral to someone better-fit.
          </p>
        </div>
      </div>

      <div class="framework">
        <div class="step">
          <div class="num">01</div>
          <h3>Intro call</h3>
          <p>Thirty minutes. The problem, the constraints, what's already been tried. Honest read on whether there's a fit.</p>
        </div>
        <div class="step">
          <div class="num">02</div>
          <h3>Scope</h3>
          <p>A short written proposal. One page. Outcomes, sequencing, and time commitment — nothing decorative.</p>
        </div>
        <div class="step">
          <div class="num">03</div>
          <h3>Start</h3>
          <p>Diagnostic kicks off within ten business days. Working sessions, not status meetings. Decisions get made.</p>
        </div>
      </div>
    </div>
  </section>

  <section style="text-align: center;">
    <div class="shell shell-narrow">
      <p class="eyebrow">Based in Toronto</p>
      <h2 style="margin-top: 1rem;">Working with founders across North America.</h2>
      <p style="margin-top: 1.25rem; color: var(--mute);">
        Selectively available · 2026
      </p>
    </div>
  </section>
</BaseLayout>
