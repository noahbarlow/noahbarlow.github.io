---
import BaseLayout from '../layouts/BaseLayout.astro';

// Each variant defined once. Default = resting cursor, Hover = on interactive elements.
// Hotspot coordinates (the "click point") matter — wrong hotspot = laggy/awkward feel.
// v2 — bolder, bigger, more obvious. All cursors 32-44px so they read at a glance.
// Hotspot coordinates (the "click point") matter — wrong hotspot = laggy/awkward feel.
const VARIANTS = [
  {
    id: 'e',
    name: 'Lime period',
    blurb: 'A confident solid dot at smiley-scale (no apologetic shrinking). End-of-sentence energy. The "period." mark.',
    defaultSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32"><circle cx="16" cy="16" r="12" fill="%23d4ff1a" stroke="%230a0a0a" stroke-width="2"/></svg>`,
    hoverSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="38" height="38" viewBox="0 0 38 38"><circle cx="19" cy="19" r="15" fill="%23d4ff1a" stroke="%230a0a0a" stroke-width="2"/><circle cx="19" cy="19" r="5" fill="%230a0a0a"/></svg>`,
    defaultHotspot: '16 16',
    hoverHotspot: '19 19',
  },
  {
    id: 'f',
    name: 'Chunky highlighter',
    blurb: 'A proper marker shape with an angled chisel tip — not a thin stripe. The cursor IS the highlighter that already lives behind every italic.',
    defaultSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="44" height="16" viewBox="0 0 44 16"><path d="M2 3 L36 3 L42 8 L36 13 L2 13 Z" fill="%23d4ff1a" stroke="%230a0a0a" stroke-width="1.2"/></svg>`,
    hoverSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="50" height="20" viewBox="0 0 50 20"><path d="M2 2 L40 2 L48 10 L40 18 L2 18 Z" fill="%23d4ff1a" stroke="%230a0a0a" stroke-width="1.5"/></svg>`,
    defaultHotspot: '4 8',
    hoverHotspot: '4 10',
  },
  {
    id: 'g',
    name: 'Lime check',
    blurb: 'A thick hand-drawn check stroke. Editorial approval at scale. "Yes — this part."',
    defaultSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32"><path d="M5 17 L13 25 L27 7" stroke="%23d4ff1a" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/><path d="M5 17 L13 25 L27 7" stroke="%230a0a0a" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.6"/></svg>`,
    hoverSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="38" height="38" viewBox="0 0 38 38"><circle cx="19" cy="19" r="16" fill="%23d4ff1a" stroke="%230a0a0a" stroke-width="1.5"/><path d="M9 20 L17 28 L29 10" stroke="%230a0a0a" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>`,
    defaultHotspot: '13 25',
    hoverHotspot: '17 28',
  },
  {
    id: 'h',
    name: 'Marker arrow',
    blurb: 'A bold lime arrow drawn like a director\'s wayfinding mark. Familiar cursor shape, distinctly his.',
    defaultSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32"><path d="M6 6 L14 6 M6 6 L6 14 M6 6 L26 26" stroke="%23d4ff1a" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/><path d="M6 6 L14 6 M6 6 L6 14 M6 6 L26 26" stroke="%230a0a0a" stroke-width="0.6" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.5"/></svg>`,
    hoverSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="38" height="38" viewBox="0 0 38 38"><path d="M6 6 L16 6 M6 6 L6 16 M6 6 L32 32" stroke="%23d4ff1a" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/><circle cx="6" cy="6" r="3" fill="%230a0a0a"/></svg>`,
    defaultHotspot: '6 6',
    hoverHotspot: '6 6',
  },
];

const css = VARIANTS.map((v) => `
  body.cursor-lab .lab-zone[data-variant="${v.id}"],
  body.cursor-lab .lab-zone[data-variant="${v.id}"] * {
    cursor: url('data:image/svg+xml;utf8,${v.defaultSvg}') ${v.defaultHotspot}, auto !important;
  }
  body.cursor-lab .lab-zone[data-variant="${v.id}"] a:hover,
  body.cursor-lab .lab-zone[data-variant="${v.id}"] button:hover,
  body.cursor-lab .lab-zone[data-variant="${v.id}"] .btn:hover {
    cursor: url('data:image/svg+xml;utf8,${v.hoverSvg}') ${v.hoverHotspot}, pointer !important;
  }
`).join('\n');
---

<BaseLayout
  title="Cursor lab · Noah Barlow"
  description="Four cursor options. Mouse into each zone, feel which one fits, pick one."
>
  <style is:inline set:html={css}></style>

  <script is:inline>
    document.body.classList.add('cursor-lab');
  </script>

  <section style="padding-top: 2rem; padding-bottom: 0;">
    <div class="shell">
      <p class="eyebrow">Cursor lab</p>
      <h1 style="margin-top: 1.25rem; max-width: 18ch;">
        Four cursors. <em>Louder this time.</em>
      </h1>
      <p style="color: var(--ink-2); max-width: 52ch; margin-top: 1.5rem;">
        Round two — bigger marks, more presence. Each cursor is at smiley-scale
        (32&ndash;44px) so it actually announces itself on the page. Mouse into
        a zone, hover the button, pick the one that fits.
      </p>
      <p style="color: var(--mute); max-width: 52ch; margin-top: 0.5rem; font-size: var(--t-sm);">
        Still off? Reply with what feels wrong and I'll keep pushing.
      </p>
    </div>
  </section>

  <section style="padding-top: 1.5rem;">
    <div class="shell">
      <div class="lab-grid">
        {VARIANTS.map((v) => (
          <div class="lab-zone" data-variant={v.id}>
            <div class="lab-zone-inner">
              <div class="runhead">
                <span class="n">{v.id.toUpperCase()}</span>
                <span class="l">{v.name}</span>
              </div>
              <h2 style="font-size: var(--t-2xl); max-width: 14ch; margin-top: 1rem;">
                {v.name}
              </h2>
              <p style="color: var(--ink-2); margin-top: 1rem; max-width: 36ch;">
                {v.blurb}
              </p>
              <p style="color: var(--ink-2); margin-top: 1.5rem; max-width: 38ch; font-size: var(--t-sm);">
                Mouse anywhere in this zone to feel the resting cursor. Hover
                the button to feel the interactive state.
              </p>
              <div style="margin-top: 1.5rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <a href="#" class="btn hot" onclick="event.preventDefault()">Hover me &rarr;</a>
                <a href="#" onclick="event.preventDefault()" style="display:inline-flex; align-items:center; padding: 0.6rem 0;">Or a plain link &rarr;</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="shell">
      <div class="contact-card">
        <div class="left">
          <p class="eyebrow">Reply with</p>
          <h2 style="margin-top: 0.85rem;">E, F, G, or H.</h2>
        </div>
        <div class="right">
          <p>
            Or "none of the above" — and tell me what feels off. A cursor is
            a small detail, but it's one of the few elements every visitor
            touches on every page. Worth getting right.
          </p>
          <p style="margin-top: 1em; color: var(--mute); font-size: var(--t-sm);">
            This page is a temporary preview. It'll be removed once you pick.
          </p>
        </div>
      </div>
    </div>
  </section>

  <style is:inline>
    .lab-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
    @media (max-width: 760px) {
      .lab-grid { grid-template-columns: 1fr; }
    }
    .lab-zone {
      background: #fff;
      border: 1px solid rgba(10,10,10,0.12);
      border-radius: 8px;
      padding: 2.5rem 2rem;
      min-height: 360px;
      transition: border-color 200ms ease, background 200ms ease;
    }
    .lab-zone:hover {
      border-color: var(--accent);
      background: #fefefe;
    }
    .lab-zone-inner { display: flex; flex-direction: column; height: 100%; }
  </style>
</BaseLayout>
