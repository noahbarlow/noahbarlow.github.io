---
import BaseLayout from '../layouts/BaseLayout.astro';

// ─────────────────────────────────────────────────────────────────────────────
// CHALLENGER SCORECARD — 8 questions, scored 0–3 each, max 24.
// Tier thresholds: 0–8 / 9–16 / 17–24.
// Each option's `s` is the score awarded for that answer.
// ─────────────────────────────────────────────────────────────────────────────
const questions = [
  {
    q: "When your team disagrees on positioning, what usually wins the room?",
    a: [
      { t: "The version most stakeholders are comfortable with.", s: 0 },
      { t: "Whatever the loudest senior leader prefers.", s: 1 },
      { t: "Whichever option performs best in testing.", s: 2 },
      { t: "The sharpest position, even when it alienates part of the room.", s: 3 },
    ],
  },
  {
    q: "Who is your brand for — really?",
    a: [
      { t: "Anyone in the category. We don't want to leave revenue on the table.", s: 0 },
      { t: "A broad target audience defined by demographics.", s: 1 },
      { t: "A specific segment we've prioritized over others.", s: 2 },
      { t: "A specific worldview. We can describe who we're not for in one sentence.", s: 3 },
    ],
  },
  {
    q: "What does your packaging system do at the shelf?",
    a: [
      { t: "Honestly, we haven't audited the pack against retail in a while.", s: 0 },
      { t: "Communicates a long list of features and benefits.", s: 1 },
      { t: "Signals category and tier cleanly. The hierarchy is decided.", s: 2 },
      { t: "Wins the three-second test and earns the look from across the aisle.", s: 3 },
    ],
  },
  {
    q: "How do you talk about your category leader?",
    a: [
      { t: "Carefully — we don't want to invite comparison.", s: 0 },
      { t: "We avoid the topic in messaging.", s: 1 },
      { t: "We position around what the leader can't easily change.", s: 2 },
      { t: "We've built our identity in deliberate contrast to what they stand for.", s: 3 },
    ],
  },
  {
    q: "What does your demand engine actually do?",
    a: [
      { t: "Mostly paid acquisition. We optimize CPA and hope.", s: 0 },
      { t: "Paid + some content. Channel mix is the strategy.", s: 1 },
      { t: "Paid, owned, and earned work in sequence around launch moments.", s: 2 },
      { t: "Demand is a system: package, retail, distribution, and content all reinforce one position.", s: 3 },
    ],
  },
  {
    q: "How often do you say no to opportunities that don't fit?",
    a: [
      { t: "Rarely. Most opportunities feel like they could work.", s: 0 },
      { t: "Sometimes, when we're stretched.", s: 1 },
      { t: "Often. We have a stated point of view on what's in and out.", s: 2 },
      { t: "Constantly. Saying no is how we hold the brand's shape.", s: 3 },
    ],
  },
  {
    q: "If you launched a new SKU tomorrow, what would happen?",
    a: [
      { t: "We'd add it to the line. It would extend the assortment.", s: 0 },
      { t: "We'd run paid against it and see what sticks.", s: 1 },
      { t: "We'd plan a launch sequence with retail readiness and content.", s: 2 },
      { t: "It would land inside a story we've been telling for years. It would belong on day one.", s: 3 },
    ],
  },
  {
    q: "What do customers actually say about your brand, unprompted?",
    a: [
      { t: "Mostly product-level feedback. Quality, taste, function.", s: 0 },
      { t: "They like us. They'd recommend us.", s: 1 },
      { t: "They use our language. They cite the brand by name.", s: 2 },
      { t: "They reference our point of view, not just our product. We're a category they belong to.", s: 3 },
    ],
  },
];

const tiers = [
  {
    range: [0, 8],
    name: "Consensus brand",
    headline: "You're being agreed with, not chosen.",
    body:
      "The brand is operating without a fight in it. Most internal decisions are landing on the survivable answer rather than the sharp one — which is why customers find the product fine but don't have a reason to talk about it. This is the most common state of CPG brands sitting between mass and premium: not failing, but not pulling. The work from here is repositioning, not refreshing.",
    recs: [
      "Pick a fight worth picking. Name what your brand is deliberately not, and put it in writing.",
      "Audit the package against retail. Stand twelve feet from a printed proof and time the three-second test honestly.",
      "Cut the audience definition in half. The smallest credible segment that genuinely needs you will outperform the broad one that tolerates you.",
      "Build a single distinctive ritual or signal customers can repeat without you in the room.",
    ],
  },
  {
    range: [9, 16],
    name: "Emerging challenger",
    headline: "You have a point of view. It hasn't fully landed yet.",
    body:
      "You've made some sharp calls — there's a position, a target, probably some packaging instinct — but the system isn't yet pulling its full weight. The most likely gap: positioning, package, and demand are running on parallel tracks rather than reinforcing each other. The brand reads as 'good' to customers but doesn't yet feel inevitable. Closing this gap is usually less work than founders expect; it's about commitment, not new ideas.",
    recs: [
      "Pressure-test the seam between brand and pack. Does the package say the same sharp thing the strategy deck says?",
      "Identify the one belief your category leader can't say — and own it on the front of the package, not on slide 14.",
      "Sequence one launch moment per quarter. Compounding visibility beats continuous noise.",
      "Find your three real customers and have a real conversation. The pattern will tell you what to commit to.",
    ],
  },
  {
    range: [17, 24],
    name: "Sharp challenger",
    headline: "The position is real. Hold it.",
    body:
      "You have what most brands in your category don't: a working point of view, a system that reinforces it, and an honest sense of who you're not for. The risk now is drift — the slow softening that happens when growth introduces new stakeholders, new SKUs, and new opinions about the brand's shape. The hardest work in front of you isn't sharpening further; it's defending what's already sharp against well-meaning suggestions to round the edges.",
    recs: [
      "Write down the things the brand will never do. Circulate it. Use it the next time someone proposes one of them.",
      "Audit the new SKUs. Each one should make the position more obvious, not more flexible.",
      "Invest in the second layer — symbols, rituals, language — that lets the brand survive a founder transition.",
      "Pick one new constraint per year to deepen the position. The work doesn't end; it concentrates.",
    ],
  },
];

const FORM_ENDPOINT = 'https://formspree.io/f/xkoerznn';
---

<BaseLayout
  title="The Challenger Scorecard · Noah Barlow"
  description="A 90-second diagnostic for founder-led brands. Score your company against the moves real challengers actually make."
>
  <script is:inline>document.body.classList.add('dx-page');</script>

  <div class="dx-bar">
    <div class="mark"><a href="/">Noah Barlow.</a></div>
    <div class="out"><a href="/">&larr; back to site</a></div>
  </div>

  <div class="dx-progress" id="dx-progress" style="--p: 0%"></div>

  <div class="dx-shell">
    <!-- COVER -->
    <aside class="dx-cover" aria-hidden="true">
      <span class="spark s1">&#10022;</span>
      <span class="spark s2">&#10022;</span>
      <span class="spark s3">&#10022;</span>
      <span class="spark s4">&#10022;</span>
      <span class="spark s5">&#10022;</span>
      <svg class="flower f1" viewBox="0 0 100 100" fill="white" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M50 8c-5 12-5 22 0 32 5-10 5-20 0-32zm32 42c-12-5-22-5-32 0 10 5 20 5 32 0zm-32 42c5-12 5-22 0-32-5 10-5 20 0 32zm-42-32c12 5 22 5 32 0-10-5-20-5-32 0zm10-30c5 8 12 14 22 17-3-10-9-17-22-17zm54 0c-13 0-19 7-22 17 10-3 17-9 22-17zm0 54c-5-8-12-14-22-17 3 10 9 17 22 17zm-54 0c13 0 19-7 22-17-10 3-17 9-22 17z"/>
      </svg>
      <h1>
        THE<br />CHALLENGER<br />SC<span class="smiley"><span class="mouth"></span></span>RECARD
      </h1>
      <p class="sub">(How challenger is your brand?)</p>
      <div class="meta">
        <div><strong>8</strong> questions</div>
        <div><strong>~90</strong> seconds</div>
        <div><strong>Free</strong> &middot; no signup</div>
      </div>
    </aside>

    <!-- FORM -->
    <main class="dx-form" id="quiz-root">
      <!-- Intro -->
      <div class="quiz-step active intro" data-step="intro">
        <div class="intro">
          <p>
            A working diagnostic for founder-led brands &mdash; based on the
            challenger framework I've used with the portfolios in
            <a href="/work" style="color:var(--dx-accent);border-color:var(--dx-accent)">my work</a>.
          </p>
          <p class="lede">
            Eight short questions. No signup to start. Sharp result. If you
            want the full Playbook + a personal note, you can drop your
            email after the score.
          </p>

          <div class="cols">
            <div>
              <span class="head">Who this is for</span>
              <ul>
                <li>Founders trying to behave bigger than they spend</li>
                <li>Teams competing against an obvious category leader</li>
                <li>Brands that suspect they're being agreed with, not chosen</li>
              </ul>
            </div>
            <div>
              <span class="head">What you'll get</span>
              <ul>
                <li>A tier read against the seven challenger moves</li>
                <li>3&ndash;5 specific moves to commit to next</li>
                <li>The Challenger Playbook PDF + a personal reply within 48h</li>
              </ul>
            </div>
          </div>

          <div class="stats">
            <span><strong>8</strong> questions</span>
            <span class="sep">&middot;</span>
            <span><strong>~90</strong> seconds</span>
            <span class="sep">&middot;</span>
            <span><strong>Free</strong> &mdash; no signup to start</span>
          </div>
        </div>
        <div style="margin-top: 1rem;">
          <button type="button" class="pill start-btn">
            <span>Start the diagnostic</span>
            <span aria-hidden="true">&rarr;</span>
          </button>
          <span class="press-hint">press <kbd>Enter</kbd> &crarr;</span>
        </div>
      </div>
      <!-- Question + results steps injected here -->
    </main>
  </div>

  <script
    is:inline
    define:vars={{
      QUESTIONS: questions,
      TIERS: tiers,
      FORM_ENDPOINT,
      DIAGNOSTIC_ID: 'challenger-scorecard',
      EMAIL_SUBJECT: 'Challenger Scorecard — new lead',
      THANKS_TITLE: "Thanks — that's in.",
      THANKS_BODY:
        "The Challenger Playbook is below. I'll personally follow up by email within 48 hours with a short note tailored to your result.",
      THANKS_PRIMARY_HREF: '/docs/Smaller_ChallengerPlaybook_V9.pdf',
      THANKS_PRIMARY_LABEL: 'Download the Playbook (PDF)',
      OTHER_DIAGNOSTIC_HREF: '/modern-brand-os',
      OTHER_DIAGNOSTIC_LABEL: 'Try the Modern Brand OS →',
      GATE_EYEBROW: 'Want the full framework',
      GATE_HEADLINE: 'Get the Challenger Playbook + a personal note from Noah.',
      GATE_SUB:
        "Send your email and I'll reply with the full 40-page playbook this scorecard is built on, plus a short note on what your result usually means in practice.",
      GATE_SUBMIT_LABEL: 'Send the playbook',
      RETAKE_LABEL: 'Retake the diagnostic',
      OPTIONAL_FIELD_LABEL: 'Role (optional)',
      HALFWAY_TOAST: "Halfway. Don't drift now.",
      TOP_TIER_INDEX: 2,
    }}
  >
    (function(){
      const root = document.getElementById('quiz-root');
      const total = QUESTIONS.length;
      const state = { answers: new Array(total).fill(null), idx: -1, locked: false };
      const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]));

      // ── playful helpers ──
      const showToast = (msg) => {
        const t = document.createElement('div');
        t.className = 'toast';
        t.textContent = msg;
        document.body.appendChild(t);
        setTimeout(() => t.remove(), 2400);
      };
      const spawnConfetti = () => {
        const c = document.createElement('div');
        c.className = 'confetti';
        c.setAttribute('aria-hidden', 'true');
        const pieces = 36;
        for (let i = 0; i < pieces; i++) {
          const piece = document.createElement('i');
          piece.style.left = Math.random() * 100 + 'vw';
          piece.style.top = (-Math.random() * 18 - 4) + 'vh';
          piece.style.animationDelay = (Math.random() * 0.5) + 's';
          piece.style.animationDuration = (1.4 + Math.random() * 1.0) + 's';
          c.appendChild(piece);
        }
        document.body.appendChild(c);
        setTimeout(() => c.remove(), 3200);
      };
      const animateCount = (el, from, to, duration) => {
        if (!el) return;
        const steps = Math.max(12, Math.abs(to - from) * 2);
        const stepMs = Math.max(16, Math.floor(duration / steps));
        let i = 0;
        el.textContent = String(from);
        const id = setInterval(() => {
          i++;
          const t = Math.min(1, i / steps);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = String(Math.round(from + (to - from) * eased));
          if (t >= 1) clearInterval(id);
        }, stepMs);
      };

      // ── keyboard ──
      document.addEventListener('keydown', (e) => {
        if (state.idx < 0 || state.idx >= total || state.locked) return;
        const key = e.key.toLowerCase();
        const map = { 'a': 0, 'b': 1, 'c': 2, 'd': 3, '1': 0, '2': 1, '3': 2, '4': 3 };
        if (!(key in map)) return;
        e.preventDefault();
        const btns = root.querySelectorAll('[data-score]');
        if (btns[map[key]]) btns[map[key]].click();
      });

      const progressBar = document.getElementById('dx-progress');
      const setProgress = (pct) => { if (progressBar) progressBar.style.setProperty('--p', pct + '%'); };

      function render() {
        if (state.idx === -1) return;
        if (state.idx >= total) return renderResults();
        const q = QUESTIONS[state.idx];
        const pct = Math.round(((state.idx + 1) / total) * 100);
        setProgress(pct);
        const options = q.a.map((opt, i) => `
          <button type="button" data-score="${opt.s}" data-i="${i}">
            <span class="k">${String.fromCharCode(65 + i)}</span>
            <span>${esc(opt.t)}</span>
            <span class="arr">&rarr;</span>
          </button>
        `).join('');
        root.innerHTML = `
          <div class="quiz-step active" data-step="${state.idx}">
            <div class="dx-q-num"><span>${state.idx + 1}</span> <span class="arr">&rarr;</span></div>
            <h2 class="dx-question">${esc(q.q)}</h2>
            <div class="dx-options">${options}</div>
            <div>
              <span class="press-hint">press <kbd>A</kbd> <kbd>B</kbd> <kbd>C</kbd> <kbd>D</kbd> or <kbd>1</kbd>&ndash;<kbd>4</kbd>${state.idx > 0 ? ' &middot; <a href="#" class="back-btn" style="color:var(--dx-mute);border-bottom:1px solid var(--dx-mute)">&larr; back</a>' : ''}</span>
            </div>
          </div>
        `;
        state.locked = false;
        root.querySelectorAll('[data-score]').forEach((btn) => {
          btn.addEventListener('click', () => {
            if (state.locked) return;
            state.locked = true;
            state.answers[state.idx] = Number(btn.dataset.score);
            btn.classList.add('picked');
            const wasIdx = state.idx;
            setTimeout(() => {
              state.idx++;
              if (wasIdx === 3 && state.idx < total) showToast(HALFWAY_TOAST);
              render();
            }, 300);
          });
        });
        const back = root.querySelector('.back-btn');
        if (back) back.addEventListener('click', (e) => {
          e.preventDefault();
          if (state.locked) return;
          state.idx = Math.max(0, state.idx - 1);
          render();
        });
      }

      function renderResults() {
        const score = state.answers.reduce((a, b) => a + (b || 0), 0);
        const tierIndex = TIERS.findIndex((t) => score >= t.range[0] && score <= t.range[1]);
        const tier = (tierIndex >= 0 ? TIERS[tierIndex] : TIERS[0]);
        const isTopTier = tierIndex === TOP_TIER_INDEX;
        const maxScore = total * 3;
        const recs = tier.recs.map((r, i) => `
          <li><span class="k">${String(i + 1).padStart(2, '0')}</span><span class="v">${esc(r)}</span></li>
        `).join('');
        root.innerHTML = `
          <div class="quiz-step active" data-step="results">
            <div class="result-card">
              <span class="stamp">${esc(tier.name)}</span>
              <div class="score"><span class="num">0</span><span class="of">/ ${maxScore}</span></div>
              <h2>${esc(tier.headline)}</h2>
              <p class="body">${esc(tier.body)}</p>
              <div class="orn-row" aria-hidden="true"><span>&#10022;</span></div>
              <p class="eyebrow" style="display:block; margin-top: 2.5rem;">Where to focus</p>
              <ol class="result-recs">${recs}</ol>
            </div>

            <div class="gate" id="gate">
              <p class="eyebrow">${esc(GATE_EYEBROW)}</p>
              <h3>${esc(GATE_HEADLINE)}</h3>
              <p class="sub">${esc(GATE_SUB)}</p>
              <form action="${FORM_ENDPOINT}" method="POST" id="lead-form">
                <input type="hidden" name="_subject" value="${esc(EMAIL_SUBJECT)}" />
                <input type="hidden" name="diagnostic" value="${DIAGNOSTIC_ID}" />
                <input type="hidden" name="score" value="${score}" />
                <input type="hidden" name="tier" value="${esc(tier.name)}" />
                <input type="email" name="email" placeholder="you@company.com" required autocomplete="email" />
                <button type="submit" class="btn hot">${esc(GATE_SUBMIT_LABEL)}</button>
                <div class="row2">
                  <input type="text" name="company" placeholder="Company (optional)" autocomplete="organization" />
                  <input type="text" name="role" placeholder="${esc(OPTIONAL_FIELD_LABEL)}" autocomplete="organization-title" />
                </div>
                <p class="legal">No newsletter. No follow-up sequence. One human reply within 48 hours.</p>
              </form>
              <div class="thanks">
                <h3>${esc(THANKS_TITLE)}</h3>
                <p class="sub" style="display: block !important;">${esc(THANKS_BODY)}</p>
                <div style="display: flex; gap: 0.85rem; flex-wrap: wrap; margin-top: 1.25rem;">
                  <a class="btn" href="${THANKS_PRIMARY_HREF}" target="_blank" rel="noopener">${esc(THANKS_PRIMARY_LABEL)}</a>
                  <a class="btn ghost" href="/contact">Book a strategy call</a>
                </div>
              </div>
            </div>

            <div class="dx-footer-actions">
              <button type="button" id="retake">${esc(RETAKE_LABEL)}</button>
              <a href="${OTHER_DIAGNOSTIC_HREF}">${esc(OTHER_DIAGNOSTIC_LABEL)}</a>
            </div>
          </div>
        `;
        setProgress(100);
        // ── playful payoff ──
        animateCount(root.querySelector('.score .num'), 0, score, 1100);
        if (isTopTier) {
          setTimeout(spawnConfetti, 420);
        }

        document.getElementById('retake').addEventListener('click', () => {
          state.answers = new Array(total).fill(null);
          state.idx = 0;
          render();
        });
        const form = document.getElementById('lead-form');
        const showError = () => {
          let err = document.getElementById('gate-err');
          if (!err) {
            err = document.createElement('p');
            err.id = 'gate-err';
            err.className = 'legal';
            err.style.color = '#a31d10';
            err.style.marginTop = '0.6rem';
            form.appendChild(err);
          }
          err.innerHTML = "That didn't send. Email <a href=\"mailto:noah@smalleragency.com\">noah@smalleragency.com</a> directly and I'll respond personally.";
        };
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const action = form.getAttribute('action');
          const submitBtn = form.querySelector('button[type="submit"]');
          if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }
          try {
            const res = await fetch(action, {
              method: 'POST',
              body: new FormData(form),
              headers: { Accept: 'application/json' },
            });
            if (res.ok) {
              if (typeof window.trackLead === 'function') {
                window.trackLead(DIAGNOSTIC_ID, { score: state.score, tier: tier.name });
              }
              document.getElementById('gate').classList.add('sent');
            } else {
              showError();
              if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = GATE_SUBMIT_LABEL; }
            }
          } catch (err) {
            showError();
            if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = GATE_SUBMIT_LABEL; }
          }
        });
      }

      document.querySelector('.start-btn').addEventListener('click', () => {
        state.idx = 0;
        render();
      });

      // Enter from intro starts the diagnostic
      document.addEventListener('keydown', (e) => {
        if (state.idx === -1 && e.key === 'Enter') {
          e.preventDefault();
          document.querySelector('.start-btn')?.click();
        }
      });
    })();
  </script>
</BaseLayout>
