---
import BaseLayout from '../layouts/BaseLayout.astro';

// ─────────────────────────────────────────────────────────────────────────────
// PACKAGING AUDIT — 8 questions, scored 0–3 each, max 24.
// Built around the three jobs from the "Why most packaging fails in three
// seconds" essay: announce category, signal tier, justify the choice.
// ─────────────────────────────────────────────────────────────────────────────
const questions = [
  {
    q: "Stand twelve feet from your package at retail. How long does it take to name the category?",
    a: [
      { t: "Honestly? More than a beat. We've never tested it that way.", s: 0 },
      { t: "Two to three seconds. There's some squinting.", s: 1 },
      { t: "About a second. It's obvious.", s: 2 },
      { t: "Instantly. You couldn't mistake it for anything else.", s: 3 },
    ],
  },
  {
    q: "Walk past your cooler door without stopping. What does the package telegraph about price?",
    a: [
      { t: "Nothing reliable. The pack reads tier-neutral at a glance.", s: 0 },
      { t: "Roughly the right zone, but it gets confused with a tier above or below.", s: 1 },
      { t: "Clearly its tier. A shopper would estimate the right zip code.", s: 2 },
      { t: "Tier is part of the brand voice — a shopper knows the price posture before turning the can.", s: 3 },
    ],
  },
  {
    q: "If a shopper picked up the package and read the front for 1.5 seconds, what would they take away?",
    a: [
      { t: "A long list of claims. Five-plus things on the front.", s: 0 },
      { t: "Three benefit pillars. We worked hard to land them.", s: 1 },
      { t: "One clear reason to choose. Everything else is in service of it.", s: 2 },
      { t: "A single belief and a posture. The pack is making an argument.", s: 3 },
    ],
  },
  {
    q: "How does your hero image earn its space?",
    a: [
      { t: "It's a beautiful photo. We love it. Category signal is around it.", s: 0 },
      { t: "It supports the product story but competes with the wordmark.", s: 1 },
      { t: "It reinforces category and tier in the same beat.", s: 2 },
      { t: "It IS the category code, restaged. The shopper reads the brand and the bet at once.", s: 3 },
    ],
  },
  {
    q: "When you compare your pack against the category leader at shelf-set size, who wins the look?",
    a: [
      { t: "They do, and it's not close.", s: 0 },
      { t: "They do, but we're in the conversation.", s: 1 },
      { t: "We hold our own. Different posture, comparable presence.", s: 2 },
      { t: "We change the rules of the look. The leader has to react to us.", s: 3 },
    ],
  },
  {
    q: "Across SKUs, what does your pack system do?",
    a: [
      { t: "Each SKU is mostly its own visual world.", s: 0 },
      { t: "There's a loose family resemblance.", s: 1 },
      { t: "There's a real system: hierarchy, color logic, structural cues.", s: 2 },
      { t: "The system tells the shopper which SKU is for them before they read the name.", s: 3 },
    ],
  },
  {
    q: "What's on the front of pack that probably shouldn't be?",
    a: [
      { t: "We've never seriously audited what to remove.", s: 0 },
      { t: "There's some clutter we know about but haven't removed yet.", s: 1 },
      { t: "We've cut a layer or two recently. It's tighter than it was.", s: 2 },
      { t: "Nothing. Every element earns its place against the three-second test.", s: 3 },
    ],
  },
  {
    q: "When customers describe what they bought, what language do they use?",
    a: [
      { t: "Product-level: 'the sparkling one,' 'the can with the dog.'", s: 0 },
      { t: "Brand name plus a feature.", s: 1 },
      { t: "Brand name plus a posture or category code we put on the pack.", s: 2 },
      { t: "Our exact language. The pack taught them how to describe it.", s: 3 },
    ],
  },
];

const tiers = [
  {
    range: [0, 8],
    name: "Invisible pack",
    headline: "The package is failing the three-second test.",
    body:
      "At shelf-set size, in a real cooler door or planogram, the package is not announcing its category clearly, not signaling its price tier reliably, and not giving a shopper a single reason to reach. This is the most expensive packaging failure in CPG — not because the pack is ugly, but because every dollar of paid media is being asked to overcome the pack's invisibility at the point of purchase. The fix is usually a rebrief, not a refresh.",
    recs: [
      "Print the current front-of-pack at retail size and view it at twelve feet. Time the category recognition honestly.",
      "Identify the three things on the front that don't earn their space — and propose a version with all three removed.",
      "Pick the single belief the pack should be defending. Put it where the eye lands first; demote everything else.",
      "Audit category codes — color, structure, typography conventions — and decide which you're keeping, breaking, or remixing on purpose.",
    ],
  },
  {
    range: [9, 16],
    name: "Adequate pack",
    headline: "Signaling, not selling.",
    body:
      "The package is doing the basics — shoppers can identify category and roughly place tier — but it isn't yet making an argument. It's getting picked up by customers who already know to look for you, and ignored by customers who don't. The shift from adequate to working pack is rarely a redesign; it's a sharpening pass on hierarchy and a willingness to remove the things diluting the single strongest signal.",
    recs: [
      "Decide what the package is actually selling. If you can't say it in one sentence, the pack can't either.",
      "Test a stripped-down version against your current pack at shelf-set size. Most teams underestimate how much they can remove.",
      "Pressure-test tier signals. If a shopper guesses ±20% on price from across the aisle, the tier is signaling.",
      "Find the shopper who skips you and ask why. Their answer is on the pack you haven't fixed.",
    ],
  },
  {
    range: [17, 24],
    name: "Working pack",
    headline: "The pack is doing its job. Defend it.",
    body:
      "The package is performing the three jobs in order — announcing category, signaling tier, justifying choice — and the system extends across SKUs without losing sharpness. The risk now is the same one every working pack faces: well-meaning additions that soften the signal. New benefit claims. New variants that drift the hierarchy. New stakeholders who want their thing on the front. The work is now disciplined defense.",
    recs: [
      "Write down what's not allowed on the front of pack. Circulate it. Use it the next time someone proposes a new claim.",
      "Audit every new SKU against the system. Each new one should make the hierarchy more obvious, not more flexible.",
      "Invest in the second layer — structural cues, color logic, distinctive ownable elements — that compound over time.",
      "Re-run this audit every twelve months. Working packs decay quietly; the only signal is the audit.",
    ],
  },
];

const FORM_ENDPOINT = 'https://formspree.io/f/xkoerznn';
---

<BaseLayout
  title="The Packaging Audit · Noah Barlow"
  description="A 90-second diagnostic for CPG founders. Score your packaging against the three-second test — announce category, signal tier, justify choice."
>
  <article class="quiz shell">
    <header class="quiz-head">
      <p class="eyebrow">Diagnostic · Packaging Audit</p>
      <h1>Is your packaging winning the three-second test?</h1>
      <p class="lede">
        Eight questions. Ninety seconds. A retail-honest audit built around
        the three jobs every package has to do at shelf — based on the
        argument in <a href="/thinking/why-most-packaging-fails-in-3-seconds">this essay</a>.
      </p>
      <div class="quiz-meta">
        <div><strong>8</strong> questions</div>
        <div><strong>~90</strong> seconds</div>
        <div><strong>Free</strong> · no signup to start</div>
      </div>
    </header>

    <div id="quiz-root">
      <div class="quiz-step active" data-step="intro">
        <div class="quiz-options" style="border-top: 0;">
          <button type="button" class="start-btn">
            <span class="k">→</span>
            <span>Start the audit</span>
            <span class="arr">↓</span>
          </button>
        </div>
      </div>
    </div>
  </article>

  <script
    is:inline
    define:vars={{
      QUESTIONS: questions,
      TIERS: tiers,
      FORM_ENDPOINT,
      DIAGNOSTIC_ID: 'packaging-audit',
      EMAIL_SUBJECT: 'Packaging Audit — new lead',
      THANKS_TITLE: "Thanks — that's in.",
      THANKS_BODY:
        "I'll personally reply within 48 hours with a written teardown against the three-second test. In the meantime, the essay this audit is built on is below.",
      THANKS_PRIMARY_HREF: '/thinking/why-most-packaging-fails-in-3-seconds',
      THANKS_PRIMARY_LABEL: 'Read the full essay',
      OTHER_DIAGNOSTIC_HREF: '/scorecard',
      OTHER_DIAGNOSTIC_LABEL: 'Try the Challenger Scorecard →',
      GATE_EYEBROW: 'Want a written read on your pack',
      GATE_HEADLINE: "Send the pack. I'll send back a 3-point teardown.",
      GATE_SUB:
        "Drop your email and (optionally) a link to your current packaging. I'll personally reply within 48 hours with three specific observations against the three-second test — no deck, no upsell, just a useful note.",
      GATE_SUBMIT_LABEL: 'Send the audit',
      RETAKE_LABEL: 'Retake the audit',
      OPTIONAL_FIELD_LABEL: 'Link to your pack (optional)',
      OPTIONAL_FIELD_NAME: 'pack_url',
      COMPANY_PLACEHOLDER: 'Brand or company',
      HALFWAY_TOAST: "Halfway. Don't blink.",
      TOP_TIER_INDEX: 2,
    }}
  >
    (function(){
      const root = document.getElementById('quiz-root');
      const total = QUESTIONS.length;
      const state = { answers: new Array(total).fill(null), idx: -1, locked: false };
      const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]));

      // ── playful helpers ──
      const showToast = (msg) => {
        const t = document.createElement('div');
        t.className = 'toast';
        t.textContent = msg;
        document.body.appendChild(t);
        setTimeout(() => t.remove(), 2400);
      };
      const spawnConfetti = () => {
        const c = document.createElement('div');
        c.className = 'confetti';
        c.setAttribute('aria-hidden', 'true');
        const pieces = 36;
        for (let i = 0; i < pieces; i++) {
          const piece = document.createElement('i');
          piece.style.left = Math.random() * 100 + 'vw';
          piece.style.top = (-Math.random() * 18 - 4) + 'vh';
          piece.style.animationDelay = (Math.random() * 0.5) + 's';
          piece.style.animationDuration = (1.4 + Math.random() * 1.0) + 's';
          c.appendChild(piece);
        }
        document.body.appendChild(c);
        setTimeout(() => c.remove(), 3200);
      };
      const animateCount = (el, from, to, duration) => {
        if (!el) return;
        const steps = Math.max(12, Math.abs(to - from) * 2);
        const stepMs = Math.max(16, Math.floor(duration / steps));
        let i = 0;
        el.textContent = String(from);
        const id = setInterval(() => {
          i++;
          const t = Math.min(1, i / steps);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = String(Math.round(from + (to - from) * eased));
          if (t >= 1) clearInterval(id);
        }, stepMs);
      };

      // ── keyboard ──
      document.addEventListener('keydown', (e) => {
        if (state.idx < 0 || state.idx >= total || state.locked) return;
        const key = e.key.toLowerCase();
        const map = { 'a': 0, 'b': 1, 'c': 2, 'd': 3, '1': 0, '2': 1, '3': 2, '4': 3 };
        if (!(key in map)) return;
        e.preventDefault();
        const btns = root.querySelectorAll('[data-score]');
        if (btns[map[key]]) btns[map[key]].click();
      });

      function render() {
        if (state.idx === -1) return;
        if (state.idx >= total) return renderResults();
        const q = QUESTIONS[state.idx];
        const pct = Math.round(((state.idx) / total) * 100);
        const options = q.a.map((opt, i) => `
          <button type="button" data-score="${opt.s}" data-i="${i}">
            <span class="k">${String.fromCharCode(65 + i)}</span>
            <span>${esc(opt.t)}</span>
            <span class="arr">&rarr;</span>
          </button>
        `).join('');
        root.innerHTML = `
          <div class="quiz-step active" data-step="${state.idx}">
            <div class="quiz-progress">
              <span>Question ${state.idx + 1} of ${total}</span>
              <span class="bar" style="--p: ${pct}%"></span>
            </div>
            <h2 class="quiz-question">${esc(q.q)}</h2>
            <div class="quiz-options">${options}</div>
            <div class="quiz-nav">
              ${state.idx > 0 ? '<button type="button" class="back-btn">&larr; Back</button>' : '<span></span>'}
              <span class="kb-hint">Tap, or press <kbd>A</kbd> <kbd>B</kbd> <kbd>C</kbd> <kbd>D</kbd></span>
            </div>
          </div>
        `;
        state.locked = false;
        root.querySelectorAll('[data-score]').forEach((btn) => {
          btn.addEventListener('click', () => {
            if (state.locked) return;
            state.locked = true;
            state.answers[state.idx] = Number(btn.dataset.score);
            btn.classList.add('picked');
            const wasIdx = state.idx;
            setTimeout(() => {
              state.idx++;
              if (wasIdx === 3 && state.idx < total) showToast(HALFWAY_TOAST);
              window.scrollTo({ top: root.getBoundingClientRect().top + window.scrollY - 80, behavior: 'instant' });
              render();
            }, 300);
          });
        });
        const back = root.querySelector('.back-btn');
        if (back) back.addEventListener('click', () => {
          if (state.locked) return;
          state.idx = Math.max(0, state.idx - 1);
          render();
        });
      }

      function renderResults() {
        const score = state.answers.reduce((a, b) => a + (b || 0), 0);
        const tierIndex = TIERS.findIndex((t) => score >= t.range[0] && score <= t.range[1]);
        const tier = (tierIndex >= 0 ? TIERS[tierIndex] : TIERS[0]);
        const isTopTier = tierIndex === TOP_TIER_INDEX;
        const maxScore = total * 3;
        const recs = tier.recs.map((r, i) => `
          <li><span class="k">${String(i + 1).padStart(2, '0')}</span><span class="v">${esc(r)}</span></li>
        `).join('');
        root.innerHTML = `
          <div class="quiz-step active" data-step="results">
            <div class="result-card">
              <span class="stamp">${esc(tier.name)}</span>
              <div class="score"><span class="num">0</span><span class="of">/ ${maxScore}</span></div>
              <h2>${esc(tier.headline)}</h2>
              <p class="body">${esc(tier.body)}</p>
              <div class="orn-row" aria-hidden="true"><span>&#10022;</span></div>
              <p class="eyebrow" style="display:block; margin-top: 2.5rem;">Where to focus</p>
              <ol class="result-recs">${recs}</ol>
            </div>

            <div class="gate" id="gate">
              <p class="eyebrow">${esc(GATE_EYEBROW)}</p>
              <h3>${esc(GATE_HEADLINE)}</h3>
              <p class="sub">${esc(GATE_SUB)}</p>
              <form action="${FORM_ENDPOINT}" method="POST" id="lead-form">
                <input type="hidden" name="_subject" value="${esc(EMAIL_SUBJECT)}" />
                <input type="hidden" name="diagnostic" value="${DIAGNOSTIC_ID}" />
                <input type="hidden" name="score" value="${score}" />
                <input type="hidden" name="tier" value="${esc(tier.name)}" />
                <input type="email" name="email" placeholder="you@company.com" required autocomplete="email" />
                <button type="submit" class="btn hot">${esc(GATE_SUBMIT_LABEL)}</button>
                <div class="row2">
                  <input type="text" name="company" placeholder="${esc(COMPANY_PLACEHOLDER)}" autocomplete="organization" />
                  <input type="text" name="${OPTIONAL_FIELD_NAME}" placeholder="${esc(OPTIONAL_FIELD_LABEL)}" />
                </div>
                <p class="legal">No newsletter. No follow-up sequence. One human reply within 48 hours.</p>
              </form>
              <div class="thanks">
                <h3>${esc(THANKS_TITLE)}</h3>
                <p class="sub" style="display: block !important;">${esc(THANKS_BODY)}</p>
                <div style="display: flex; gap: 0.85rem; flex-wrap: wrap; margin-top: 1.25rem;">
                  <a class="btn" href="${THANKS_PRIMARY_HREF}">${esc(THANKS_PRIMARY_LABEL)}</a>
                  <a class="btn ghost" href="/contact">Book a strategy call</a>
                </div>
              </div>
            </div>

            <div style="margin-top: clamp(2rem,4vw,3rem); display:flex; justify-content:space-between; gap: 1rem; flex-wrap: wrap;">
              <button type="button" class="btn ghost" id="retake">${esc(RETAKE_LABEL)}</button>
              <a class="btn ghost" href="${OTHER_DIAGNOSTIC_HREF}">${esc(OTHER_DIAGNOSTIC_LABEL)}</a>
            </div>
          </div>
        `;
        // ── playful payoff ──
        animateCount(root.querySelector('.score .num'), 0, score, 1100);
        if (isTopTier) {
          setTimeout(spawnConfetti, 420);
        }

        document.getElementById('retake').addEventListener('click', () => {
          state.answers = new Array(total).fill(null);
          state.idx = 0;
          render();
        });
        const form = document.getElementById('lead-form');
        const showError = () => {
          let err = document.getElementById('gate-err');
          if (!err) {
            err = document.createElement('p');
            err.id = 'gate-err';
            err.className = 'legal';
            err.style.color = '#a31d10';
            err.style.marginTop = '0.6rem';
            form.appendChild(err);
          }
          err.innerHTML = "That didn't send. Email <a href=\"mailto:noah@smalleragency.com\">noah@smalleragency.com</a> directly and I'll respond personally.";
        };
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const action = form.getAttribute('action');
          const submitBtn = form.querySelector('button[type="submit"]');
          if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }
          try {
            const res = await fetch(action, {
              method: 'POST',
              body: new FormData(form),
              headers: { Accept: 'application/json' },
            });
            if (res.ok) {
              document.getElementById('gate').classList.add('sent');
            } else {
              showError();
              if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = GATE_SUBMIT_LABEL; }
            }
          } catch (err) {
            showError();
            if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = GATE_SUBMIT_LABEL; }
          }
        });
      }

      document.querySelector('.start-btn').addEventListener('click', () => {
        state.idx = 0;
        render();
      });
    })();
  </script>
</BaseLayout>
